# Safety net for the dotfiles bare repo.
# Paths are anchored to $HOME (leading slash). Default invisibility comes from
# `status.showUntrackedFiles=no`; these patterns block an accidental `dot add -A`
# from capturing secrets or churn.


# The bare repo itself (would otherwise be committed by `dot add .`)
/.dotfiles/

# Untracked Ubuntu skel files we don't care to track
/.bash_logout
/.profile

# Project workspaces (their own git repos)
/workspace/

# Caches and tool installs (rebuilt by bootstrap.sh)
/.cache/
/.npm/
/.dotnet/
/.vscode-server/
/.copilot/
/.asdf/
/.local/

# box-mcp dependencies (restored by `npm ci` in bootstrap.sh). Its runtime
# state — OAuth tokens, audit log — lives under /.local/state/, ignored above.
/box-mcp/node_modules/

# noVNC client for the remote desktop (fetched, checksum-pinned, by bootstrap.sh)
/desktop/web/novnc/

# Secrets / credentials
/.ssh/
/.claude.json
/.config/gh/

# Remote desktop. The Chrome profile holds logged-in sessions (cookies there
# are protected by file permissions only — see desktop/bin/chrome); .Xauthority
# is the display's access cookie.
/.config/google-chrome/
/.Xauthority

# Per-machine secrets & env (API tokens, etc.) — sourced by .bashrc
/.bashrc.local

# Per-machine identity (user.name, user.email) — included by .gitconfig
/.gitconfig.local

# Logs and shell history
/.bash_history
/.viminfo
/.wget-hsts
/.sudo_as_admin_successful

# Claude Code state — sessions, plugins, credentials all live here.
# Everything is ignored except the explicitly whitelisted config files
# (`/.claude/*` instead of `/.claude/` so the negations below can apply).
/.claude/*
!/.claude/CLAUDE.md
!/.claude/settings.json
!/.claude/statusline-command.sh
!/.claude/statusline-command.py

# Created on first bootstrap when checkout collides with skel files
/.dotfiles-backup/
