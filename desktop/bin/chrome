#!/usr/bin/env bash
# The desktop's Chrome: an ordinary Chrome on its default profile, with no
# automation flags — Claude drives it through the Claude in Chrome extension,
# so websites see a normal browser. XFCE autostart, the dock/menu icon and
# Claude all start Chrome through this. If it is already running, this just
# opens a window (or the given URL) in it.
set -euo pipefail

export DISPLAY="${DISPLAY:-:1}"

# --password-store=basic: no keyring prompts; cookies rely on file permissions.
# Every launch has to agree on it or Chrome can't decrypt its own cookies and
# logs you out everywhere — the reason the dock and menu go through this script.
# setsid -f: outlive the shell that launched us (e.g. Claude's Bash tool).
exec setsid -f google-chrome-stable \
  --password-store=basic \
  --no-first-run --no-default-browser-check --start-maximized \
  "$@" >/dev/null 2>&1
